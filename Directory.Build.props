<Project>

  <!--
    Shared build settings for every AlarmHub project.
    Reason: one place defines language level, nullable context, analyzers and documentation rules
    so that all services follow the same quality bar (see 17_PROJECT_LAB_RULES.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 = missing XML comment for publicly visible type/member: kept as warning while the
         solution is being built up; the goal is zero warnings before the first public release. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Test method names intentionally use underscores (Method_Scenario_Expected), which CA1707 flags. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
